generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  PATIENT
  NURSE
  DOCTOR
  FAMILY_MEMBER
  MANAGER
  ADMIN
}

// Matches the four input methods in the care-note form.
enum CareNoteType {
  TEXT
  IMAGE
  VOICE
  FAMILY_UPDATE
}

// Mirrors the app's ProblemStatus union — keeps the full clinical history
// (a Resolved entry is never deleted, just re-labelled).
enum DiagnosisStatus {
  ACTIVE
  CHRONIC
  RESOLVED
  OTHER
}

// Two distinct audiences for a discharge summary: the GP letter and the
// plain-language patient-facing version.
enum DischargeAudience {
  GP
  PATIENT
}

enum DischargeSummaryStatus {
  DRAFT
  FINALIZED
}

// ─── Core identity ───────────────────────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role
  // "hospital" | "agedcare" — which facility this account belongs to.
  // Stored here so the JWT callback can read it from the DB rather than
  // relying purely on the login-form credential.
  org       String   @default("hospital")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  patientProfile PatientProfile? @relation("PatientUser")
  familyLinks    FamilyLink[]    @relation("FamilyMember")
  careNotes      CareNote[]
  referrals      ReferralNote[]  @relation("ReferralAuthor")
  auditLogs      AuditLog[]
}

model PatientProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  org         String    // "hospital" | "agedcare"
  dateOfBirth DateTime?
  // Full ward/room label, e.g. "Ward 3B" or "Room 12B".
  // A single field is enough — roomNumber was a redundant duplicate.
  ward        String?
  allergies   String[]
  // { mood, appetite, mobility, sleep } each 1–10 — the personal baseline
  // that wellbeing scores are compared against to detect concern flags.
  baseline    Json      @default("{\"mood\":5,\"appetite\":5,\"mobility\":5,\"sleep\":5}")
  // { preferences, routine, communicationStyle } free-text care preferences.
  profile     Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user               User               @relation("PatientUser", fields: [userId], references: [id], onDelete: Cascade)
  familyLinks        FamilyLink[]
  diagnoses          Diagnosis[]
  medications        Medication[]
  careNotes          CareNote[]
  wellbeingChecks    WellbeingCheck[]
  vitals             VitalSigns[]
  referrals          ReferralNote[]
  dischargeSummaries DischargeSummary[]
  chatMessages       ChatMessage[]
  reports            MedicalReport[]
  auditLogs          AuditLog[]
}

model FamilyLink {
  id               String   @id @default(cuid())
  familyMemberId   String
  patientProfileId String
  relationship     String   // "daughter", "son", "spouse", etc.
  createdAt        DateTime @default(now())

  familyMember   User           @relation("FamilyMember", fields: [familyMemberId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)

  @@unique([familyMemberId, patientProfileId])
}

// ─── Patient clinical data ───────────────────────────────────────────────────

model Diagnosis {
  id               String          @id @default(cuid())
  patientProfileId String
  condition        String
  status           DiagnosisStatus @default(ACTIVE)
  notes            String?
  authorRole       String          // display identity of the clinician, e.g. "Dr. Chen (Doctor)"
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model Medication {
  id               String   @id @default(cuid())
  patientProfileId String
  name             String
  dose             String
  frequency        String
  createdAt        DateTime @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

// Replaces the old NursingNote model, which used a different type enum and
// didn't map to how the dashboard actually stores notes.
model CareNote {
  id               String       @id @default(cuid())
  patientProfileId String
  authorId         String
  // Full display identity, e.g. "Sarah Jones (Nurse)".
  // Redundant with authorId but stored here so readers never need a join
  // just to display who wrote a note.
  authorRole       String
  type             CareNoteType @default(TEXT)
  content          String
  imageUrl         String?
  // Sensitive notes are hidden from the family/patient view.
  sensitive        Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  author         User           @relation(fields: [authorId], references: [id])
}

// Replaces HealthRecord — the fields now match the four-axis wellbeing model
// the dashboard actually logs and charts (mood, appetite, mobility, sleep).
model WellbeingCheck {
  id               String   @id @default(cuid())
  patientProfileId String
  mood             Int      // 1–10
  appetite         Int      // 1–10
  mobility         Int      // 1–10
  sleep            Int      // 1–10
  recordedAt       DateTime @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model VitalSigns {
  id               String   @id @default(cuid())
  patientProfileId String
  authorRole       String
  systolic         Int?     // mmHg
  diastolic        Int?     // mmHg
  heartRate        Int?     // bpm
  temperature      Float?   // °C
  oxygenSaturation Float?   // %
  respiratoryRate  Int?     // breaths/min
  recordedAt       DateTime @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model ReferralNote {
  id               String    @id @default(cuid())
  patientProfileId String
  authorId         String
  fromName         String
  toRecipient      String    // free text — department, specialty, or named clinician
  subject          String
  message          String
  acknowledged     Boolean   @default(false)
  acknowledgedBy   String?
  acknowledgedAt   DateTime?
  // Optional share code so the referral can be viewed without logging in
  // (e.g. sent to an external specialist).
  shareCode        String?   @unique
  createdAt        DateTime  @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
  author         User           @relation("ReferralAuthor", fields: [authorId], references: [id])
}

model DischargeSummary {
  id               String                 @id @default(cuid())
  patientProfileId String
  audience         DischargeAudience
  content          String
  generatedBy      String                 // display identity of the author
  status           DischargeSummaryStatus @default(DRAFT)
  finalizedBy      String?
  finalizedAt      DateTime?
  // True if a clinician has manually edited the AI-generated draft.
  edited           Boolean                @default(false)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

// Shared family-staff message thread, one per patient.
model ChatMessage {
  id               String   @id @default(cuid())
  patientProfileId String
  authorName       String
  // Full display identity, e.g. "Lena Chen (Family)".
  authorRole       String
  content          String
  createdAt        DateTime @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

model MedicalReport {
  id               String   @id @default(cuid())
  patientProfileId String
  title            String
  // "Blood Test" | "CT Scan" | "MRI" | "X-Ray" | "Other"
  type             String
  content          String?
  imageUrl         String?
  authorRole       String
  createdAt        DateTime @default(now())

  patientProfile PatientProfile @relation(fields: [patientProfileId], references: [id], onDelete: Cascade)
}

// ─── Compliance ──────────────────────────────────────────────────────────────

// Kept for compliance/auditing — every sensitive action (view patient record,
// create note, generate AI summary) should write an entry here.
model AuditLog {
  id               String   @id @default(cuid())
  userId           String
  patientProfileId String?  // null for non-patient actions (e.g. login)
  action           String   // "VIEW_PATIENT" | "CREATE_NOTE" | "GENERATE_HANDOVER" | etc.
  metadata         Json?
  ipAddress        String?
  createdAt        DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  patientProfile PatientProfile? @relation(fields: [patientProfileId], references: [id], onDelete: SetNull)
}
