# ================================================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real secrets.
# ================================================================

# ── Database (Supabase PostgreSQL) ───────────────────────────────
#
# LOCAL / DOCKER  → use the Direct Connection or Session Pooler (port 5432)
DATABASE_URL="postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"
#
# VERCEL SERVERLESS → use the Transaction Pooler (port 6543) to avoid
# exhausting connections with many concurrent function invocations:
# DATABASE_URL="postgresql://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# Find both strings in: Supabase Dashboard → Settings → Database → Connection string

# ── NextAuth ─────────────────────────────────────────────────────
# Must match the URL the app is served from.
NEXTAUTH_URL="http://localhost:3000"

# Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ── Gemini AI (Google AI Studio) ─────────────────────────────────
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="AIzaSy..."
